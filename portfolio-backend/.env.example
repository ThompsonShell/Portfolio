# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://asilbek.me

# Database (server's native PostgreSQL, not Docker)
DB_NAME=portfolio_db
DB_USER=portfolio_user
